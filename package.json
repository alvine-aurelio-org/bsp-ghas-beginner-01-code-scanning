{
  "name": "bsp-ghas-beginner-01-code-scanning",
  "version": "0.1.0",
  "private": true,
  "description": "Beginner GHAS Lab 01: Find and fix your first CodeQL alerts; synthetic local training only",
  "type": "commonjs",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "start": "node src/server.cjs",
    "test": "node --test test/baseline.test.cjs test/mock-provider.test.cjs test/metrics.test.cjs",
    "test:security": "node --test test/security.test.cjs test/rate-limit.test.cjs",
    "test:rate-limit": "node --test test/rate-limit.test.cjs",
    "test:compatibility": "node --test test/dependency-policy.test.cjs",
