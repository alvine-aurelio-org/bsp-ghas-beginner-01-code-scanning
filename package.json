    "lab:status": "node .workshop/cli.cjs status",
    "lab:enable": "node .workshop/cli.cjs enable",
    "lab:gates": "node .workshop/cli.cjs gates",
    "lab:secret-response": "node .workshop/local-demos.cjs secret-response",
    "lab:metrics": "node .workshop/local-demos.cjs metrics",
    "lab:smoke": "node .workshop/local-demos.cjs smoke",
    "lab:push-check": "node .workshop/push-probe.cjs"
